// Demo of window shaders. Run it nested in your session with examples/demo.sh, or:
//
//     cargo run --release -- -c examples/demo-config.kdl
//
// Nested, the Mod key is Alt. Mod+Shift+S cycles the presets on the focused window.
//
// It opens six windows, each with its own shader:
//
//     kitty (island glass)      firefox (neon edge)         kitty (crt)
//     kitty (hologram)          kitty (matrix)              kitty (rain)

prefer-no-csd

layout {
    gaps 16
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    shadow {
        on
    }
}

animations {
    // Slow enough to watch the dissolve preset.
    window-close {
        duration-ms 700
        curve "linear"
    }
}

screenshot-path "~/Pictures/Screenshots/niri-shaders %Y-%m-%d %H-%M-%S.png"

// A wallpaper makes the glass shaders look like glass. examples/demo.sh passes it in
// NIRI_DEMO_WALLPAPER.
spawn-sh-at-startup "[ -n \"$NIRI_DEMO_WALLPAPER\" ] && exec swaybg -i \"$NIRI_DEMO_WALLPAPER\" -m fill"

spawn-at-startup "kitty" "-o" "background_opacity=0.55"
spawn-sh-at-startup "mkdir -p /tmp/niri-shaders-demo-firefox && exec firefox --no-remote --profile /tmp/niri-shaders-demo-firefox https://github.com/niri-wm/niri"
spawn-at-startup "kitty" "--class" "demo-crt" "-o" "font_size=7" "btop"
spawn-at-startup "kitty" "--class" "demo-hologram" "sh" "-c" "fastfetch; exec $SHELL"
spawn-at-startup "kitty" "--class" "demo-matrix" "sh" "-c" "ls -la --color=always /usr/bin; exec $SHELL"
spawn-at-startup "kitty" "--class" "demo-rain" "-o" "background_opacity=0.3" "sh" "-c" "fastfetch; exec $SHELL"

window-rule {
    match app-id="^kitty$"
    geometry-corner-radius 14
    clip-to-geometry true
    // Blur turns on by itself with the island-glass preset.
    shader "preset:island-glass" {
        // Gentler than the ShojiWM defaults, so the text stays readable.
        uniform "refraction_px" 40
        uniform "chromatic_shift_px" 1.5
    }
}

window-rule {
    match app-id="^firefox$"
    geometry-corner-radius 12
    clip-to-geometry true
    shader "preset:neon-edge" {
        uniform "width" 4
        uniform "speed" 0.3
    }
}

window-rule {
    match app-id="^demo-crt$"
    shader "preset:crt" {
        uniform "intensity" 0.8
        uniform "tint" 0.75 1.0 0.8
    }
}

window-rule {
    match app-id="^demo-hologram$"
    shader "preset:hologram"
}

window-rule {
    match app-id="^demo-matrix$"
    shader "preset:matrix"
}

window-rule {
    match app-id="^demo-rain$"
    shader "preset:rain"
}

// The six startup windows float in a 3 × 2 grid that fits any screen.
window-rule {
    match app-id="^kitty$" at-startup=true
    match app-id="^firefox$" at-startup=true
    match app-id="^demo-" at-startup=true
    open-floating true
    default-column-width { proportion 0.31; }
    default-window-height { proportion 0.46; }
}
window-rule {
    match app-id="^kitty$" at-startup=true
    default-floating-position x=24 y=24 relative-to="top-left"
}
window-rule {
    match app-id="^firefox$" at-startup=true
    default-floating-position x=0 y=24 relative-to="top"
}
window-rule {
    match app-id="^demo-crt$" at-startup=true
    default-floating-position x=24 y=24 relative-to="top-right"
}
window-rule {
    match app-id="^demo-hologram$" at-startup=true
    default-floating-position x=24 y=24 relative-to="bottom-left"
}
window-rule {
    match app-id="^demo-matrix$" at-startup=true
    default-floating-position x=0 y=24 relative-to="bottom"
}
window-rule {
    match app-id="^demo-rain$" at-startup=true
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

binds {
    Mod+Shift+S { cycle-window-shader; }

    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+T { spawn "kitty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+O { toggle-overview; }
    Mod+Shift+E { quit; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R       { switch-preset-column-width; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }

    Print { screenshot; }
    Mod+Shift+P { screenshot-screen; }
}
